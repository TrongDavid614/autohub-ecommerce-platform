/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 2. Next.js & Build Outputs
# ==========================================
/.next/
/out/
/build
/dist
/coverage

# ==========================================
